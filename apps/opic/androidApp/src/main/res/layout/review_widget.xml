<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 복습 위젯(F19.6). 글 두 줄만 보이고 통째로 누르면 복습 화면이 열린다. 글은 앱이 공통 문구로 채운다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/review_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/review_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/review_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/review_widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/review_widget_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/review_widget_text_secondary"
        android:textSize="14sp" />
</LinearLayout>
